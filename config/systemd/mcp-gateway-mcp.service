[Unit]
Description=MCP Gateway Official MCP Adapter (Streamable HTTP)
After=network.target mcp-gateway-admin.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mcp-gateway
Group=mcp-gateway
WorkingDirectory=/home/mcp-gateway/mcp-gateway
ExecStart=/home/mcp-gateway/mcp-gateway/bin/mcp-gateway-adapter -transport http -bind 127.0.0.1:8090 -python /usr/bin/python3 -pythonpath /home/mcp-gateway/mcp-gateway/src -auth-token-file /home/mcp-gateway/.config/mcp-gateway/tunnel-mcp.token -client-id chatgpt-main
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
