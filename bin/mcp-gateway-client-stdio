#!/bin/sh
# MCP Gateway Client SSH Forced Command Wrapper
# Strictly enforces authenticated client identity bound by SSH key.
# Discards any arbitrary command supplied over SSH.
set -eu

CLIENT_ID="${1:-}"
if [ -z "${CLIENT_ID}" ]; then
    echo "ERROR: Client ID must be specified in forced command configuration" >&2
    exit 1
fi

# Discard arbitrary SSH command argument to prevent command injection/spoofing
unset SSH_ORIGINAL_COMMAND 2>/dev/null || true

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

if [ -d "${ROOT_DIR}/src" ]; then
    export PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
elif [ -d "/home/mcp-gateway/mcp-gateway/src" ]; then
    export PYTHONPATH="/home/mcp-gateway/mcp-gateway/src:${PYTHONPATH:-}"
fi

export MCP_CLIENT_ID="${CLIENT_ID}"

ADAPTER_BIN="${ROOT_DIR}/bin/mcp-gateway-adapter"
if [ ! -x "${ADAPTER_BIN}" ]; then
    ADAPTER_BIN="${ROOT_DIR}/mcp-adapter/mcp-gateway-adapter.armv6"
fi
if [ ! -x "${ADAPTER_BIN}" ]; then
    ADAPTER_BIN="/home/mcp-gateway/mcp-gateway/bin/mcp-gateway-adapter"
fi
if [ ! -x "${ADAPTER_BIN}" ]; then
    ADAPTER_BIN="/home/mcp-gateway/mcp-gateway/mcp-adapter/mcp-gateway-adapter.armv6"
fi

if [ ! -x "${ADAPTER_BIN}" ]; then
    echo "ERROR: Official MCP adapter binary not found or not executable: ${ADAPTER_BIN}" >&2
    exit 1
fi

exec "${ADAPTER_BIN}" --transport stdio --client-id "${CLIENT_ID}"
