#!/bin/sh
# Controlled appliance reboot helper for MCP-Pi Gateway
# Rejects any arguments (fail-closed, no arbitrary command injection)
if [ "$#" -ne 0 ]; then
    echo "Error: mcp-gateway-reboot accepts zero arguments" >&2
    exit 1
fi
echo "[mcp-gateway-reboot] Initiating clean appliance reboot..."
sync
exec /sbin/reboot
